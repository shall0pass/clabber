# Drizzle
DATABASE_URL=local.db

# Automerge sync server the browser connects to.
#   local dev / docker : ws://localhost:3030
#   Cloudflare Pages    : wss://sync.automerge.org  (the public relay)
#
# The join-code registry at /games/:code is same-origin: in dev Vite proxies it
# to this host, in production it's a Cloudflare Pages Function. See
# docs/deploy-cloudflare.md.
PUBLIC_SYNC_URL=ws://localhost:3030
