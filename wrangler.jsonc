{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clabber",
	"pages_build_output_dir": "./build",
	"compatibility_date": "2026-08-28",

	// Short join codes + the public "looking for players" list are served by
	// functions/games/*.js, which need this KV namespace. Without it those
	// Functions 500, codes silently fall back to the raw document id, and no
	// game is ever published to GET /games.
	//
	// `id` is used by remote deploys (production + preview); `preview_id` is used
	// by local `wrangler pages dev`. One namespace serves both here — it only
	// holds short-lived join codes.
	"kv_namespaces": [
		{
			"binding": "GAMES",
			"id": "89082b8c91ef46e9b1cb960ed485bed0",
			"preview_id": "89082b8c91ef46e9b1cb960ed485bed0"
		}
	]
}
